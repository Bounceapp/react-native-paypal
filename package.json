{
  "name": "@bounceapp/react-native-paypal",
  "private": false,
  "license": "MIT",
  "version": "1.0.0",
  "description": "React Native wrapper to bridge PayPal iOS and Android SDK",
  "keywords": [
    "expo",
    "paypal",
    "braintree",
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/Bounceapp/react-native-paypal",
  "author": "Bounce (https://usebounce.com)",
  "bugs": {
    "url": "https://github.com/Bounceapp/react-native-paypal/issues"
  },
  "homepage": "https://github.com/Bounceapp/react-native-paypal#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-paypal.podspec",
    "expo-module.config.json",
    "app.plugin.js",
    "plugin",
    "!lib/typescript/example",
    "!android/build",
    "!android/src/test",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest --passWithNoTests",
    "typecheck": "tsc",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "lint:kotlin": "sh scripts/detekt.sh",
    "lint-staged": "lint-staged --allow-empty",
    "prepare": "bob build && husky install",
    "release": "release-it",
    "docs": "typedoc ./src/index.ts --out ./docs --tsconfig ./tsconfig.json --readme none --sort source-order",
    "example": "pnpm --filter @bounceapp/react-native-paypal-example",
    "bootstrap": "pnpm install"
  },
  "devDependencies": {
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/jest": "28.1.8",
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "commitlint": "17.8.1",
    "expo": "58.0.23",
    "husky": "8.0.3",
    "jest": "^29.2.1",
    "lint-staged": "13.3.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "pod-install": "0.3.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "0.44.1",
    "react-native-safe-area-context": "~5.11.1",
    "release-it": "21.1.2",
    "typedoc": "0.28.20",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": ">=56.0.0",
    "react": "*",
    "react-native": ">=0.85.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "oxlint --fix",
    "*.{ts,tsx,js,jsx,css,md,json}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "packageManager": "pnpm@12.18.0"
}

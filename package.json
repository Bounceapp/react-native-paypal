{
  "name": "@bounceapp/react-native-paypal",
  "private": false,
  "license": "MIT",
  "version": "0.8.0",
  "description": "React Native wrapper to bridge PayPal iOS and Android SDK",
  "keywords": [
    "expo",
    "paypal",
    "braintree",
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/Bounceapp/react-native-paypal",
  "author": "Bounce (https://usebounce.com)",
  "bugs": {
    "url": "https://github.com/Bounceapp/react-native-paypal/issues"
  },
  "homepage": "https://github.com/Bounceapp/react-native-paypal#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-paypal.podspec",
    "expo-module.config.json",
    "app.plugin.js",
    "plugin",
    "!lib/typescript/example",
    "!android/build",
    "!android/src/test",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest --passWithNoTests",
    "typecheck": "tsc",
    "lint": "npx eslint . --ext .ts,.tsx,.js",
    "lint:fix": "npx eslint . --ext .ts,.tsx,.js --fix",
    "lint:kotlin": "sh scripts/detekt.sh",
    "lint-staged": "lint-staged --allow-empty",
    "prepare": "bob build && husky install",
    "release": "release-it",
    "docs": "yarn typedoc ./src/index.ts --out ./docs --tsconfig ./tsconfig.json --readme none --sort source-order",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.29.9",
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/eslint": "8.56.12",
    "@types/jest": "28.1.8",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "commitlint": "17.8.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-universe": "14.3.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-n": "14.0.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-native": "4.1.0",
    "eslint-plugin-unused-imports": "2.0.0",
    "expo": "56.0.22",
    "husky": "8.0.3",
    "jest": "^29.2.1",
    "lint-staged": "13.3.0",
    "pod-install": "0.3.10",
    "prettier": "3.9.9",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "0.43.1",
    "react-native-safe-area-context": "~5.10.0",
    "release-it": "21.1.0",
    "typedoc": "0.28.20",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "expo": ">=56.0.0",
    "react": "*",
    "react-native": ">=0.85.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "npx eslint --cache --fix",
    "*.{ts,tsx,js,jsx,css,md,json}": "npx prettier --write"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}

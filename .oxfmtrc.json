{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "bracketSameLine": true,
  "sortPackageJson": false,
  "sortImports": {
    "groups": ["builtin", "external", ["parent", "sibling", "index"]],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true
  },
  "ignorePatterns": [
    "node_modules",
    "lib",
    "docs",
    "example/android",
    "example/ios",
    "pnpm-lock.yaml"
  ],
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "sortImports": false
      }
    }
  ]
}
